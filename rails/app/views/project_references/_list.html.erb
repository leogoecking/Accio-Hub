<div class="block-top"><h2>Links e materiais <span class="badge" id="reference-count"><%= @references.size %></span></h2><% unless @project.status == "archived" %><%= link_to "+ Nova referência", new_project_reference_path(@project), class: "button tertiary", id: "reference-new", data: {turbo_frame: "reference-modal", reference_opener: true} %><% end %></div>
<% @references.each do |reference| %><article class="space-reference" data-reference-uid="<%= reference.to_param %>"><div class="block-top"><h3><%= reference.title %></h3><% unless @project.status == "archived" %><%= link_to "Editar", edit_project_reference_path(@project, reference), class: "button tertiary", id: "reference-edit-#{reference.to_param}", aria: {label: "Editar #{reference.title}"}, data: {turbo_frame: "reference-modal", reference_opener: true} %><% end %></div><small class="muted"><%= reference.kind == "link" ? "LINK" : "MATERIAL" %></small><p><%= reference.description %></p><% if (url = safe_reference_url(reference.url)) %><%= link_to "Abrir #{reference.title}", url, target: "_blank", rel: "noopener noreferrer" %><% elsif reference.url.present? %><p class="muted">URL incompatível · link desativado por segurança. O conteúdo foi preservado.</p><p class="muted" data-reference-url-incompatible><%= reference.url %></p><% else %><p class="muted">Material descrito neste espaço · sem arquivo anexado.</p><% end %></article><% end %>
<% if @references.empty? %><p class="space-empty">Nenhuma referência ainda. Reúna links e descrições de materiais para consultar depois.</p><% end %>
