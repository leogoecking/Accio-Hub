<turbo-frame id="reference-modal"><dialog class="dialog global-dialog project-dialog project-native-dialog" data-project-dialog data-reference-dialog data-controller="reference-form" data-action="cancel->reference-form#cancel close->reference-form#afterClose keydown->reference-form#keys" aria-labelledby="reference-dialog-title" aria-describedby="reference-form-hint">
  <%= form_with url: @reference.persisted? ? project_reference_path(@project, @reference) : project_references_path(@project), method: @reference.persisted? ? :patch : :post, scope: :reference, id: "reference-form", data: {action: "submit->reference-form#submit input->reference-form#preview change->reference-form#preview"} do |form| %>
    <%= hidden_field_tag :intent, @intent unless @reference.persisted? %><%= hidden_field_tag :version, @reference.lock_version %>
    <div class="block-top"><h2 id="reference-dialog-title"><%= @reference.persisted? ? "Editar referência" : "Nova referência" %></h2><button type="button" class="mini-control" data-action="reference-form#close" aria-label="Fechar formulário de referência"><%= studio_icon("x") %></button></div>
    <label for="reference-title">Título<%= form.text_field :title, value: @reference.title, id: "reference-title", required: true, maxlength: 120, autocomplete: "off", autofocus: true %></label>
    <label for="reference-kind">Tipo<%= form.select :kind, [["Link", "link"], ["Material", "material"]], {selected: @reference.kind}, id: "reference-kind" %></label>
    <label for="reference-url">URL <span class="project-optional">obrigatória para links</span><%= form.url_field :url, value: @reference.url, id: "reference-url", placeholder: "https://", required: @reference.kind == "link" %></label>
    <label for="reference-description">Descrição do material ou link<%= form.text_area :description, value: @reference.description, id: "reference-description", maxlength: 2000, rows: 3 %></label>
    <p class="project-form-error" role="alert" data-project-notice></p><p hidden data-reference-remote></p><div class="project-conflict-actions"><button type="button" class="button tertiary" hidden data-reference-reapply data-action="reference-form#reapply">Reaplicar minha edição</button><button type="button" class="button tertiary" hidden data-reference-reload data-action="reference-form#reload">Carregar versão atual</button></div>
    <p id="reference-form-hint" class="muted">Salva no SQLite neste projeto. Materiais podem ser descritos sem URL; nenhum arquivo será anexado.</p><div class="project-form-actions"><button type="button" class="button tertiary" data-action="reference-form#close">Cancelar</button><button type="submit" class="button"><%= studio_icon("check", 16) %> Salvar referência</button></div>
  <% end %>
</dialog></turbo-frame>
