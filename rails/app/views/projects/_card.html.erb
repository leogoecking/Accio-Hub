<article class="project-card <%= 'is-archived' if project.status == 'archived' %>" style="<%= project_style(project) %>">
  <div class="project-card-top"><span class="project-emblem"><%= studio_icon(project.icon, 25) %></span><span class="project-status status-<%= project.status %>"><i aria-hidden="true"></i><%= ProjectsHelper::PROJECT_STATUSES.fetch(project.status) %></span><% unless project.status == "archived" %><%= project_control(project, "favorite", project.favorite ? "Desfavoritar #{project.name}" : "Favoritar #{project.name}", favorite: !project.favorite) %><% end %></div>
  <h2><%= link_to project_path(project), class: "project-space-link", data: {turbo_frame: "_top"} do %><%= project.name %> <%= studio_icon("chevron", 16) %><% end %></h2><p class="project-description"><%= project.description.presence || "Um espaço pronto para suas próximas ideias." %></p>
  <% count = @pending_counts.fetch(project.id, 0) %><div class="project-relations"><span><%= studio_icon("check", 15) %><strong><%= count %></strong> tarefa<%= 's' unless count == 1 %> aberta<%= 's' unless count == 1 %></span><span><%= studio_icon("book", 15) %>Conhecimento · P1.3</span></div>
  <div class="project-card-bottom"><span class="project-activity"><%= project.last_activity_at ? "Atualizado em #{project.last_activity_at.strftime('%d/%m/%Y')}" : "Sem atividade registrada" %></span><div class="project-controls"><% if project.status == "archived" %><%= project_control(project, "restore", "Restaurar") %><% else %><%= link_to edit_project_path(project), class: "project-control", id: "project-edit-#{project.to_param}", data: {turbo_frame: "project-modal", project_opener: true} do %><%= studio_icon("edit", 15) %> Editar<% end %><%= project_control(project, "status", project.status == "active" ? "Pausar" : "Ativar", status: project.status == "active" ? "paused" : "active") %><%= project_control(project, "archive", "Arquivar") %><% end %></div></div>
</article>
