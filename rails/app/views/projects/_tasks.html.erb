<p class="muted">Consulta somente leitura. Edição prevista para a P1.2D2.</p><% tasks.each do |task| %><div class="task-item <%= 'is-done' if task.status == 'completed' %>"><span class="task-name"><%= task.title %><small><%= task.status == 'completed' ? 'Concluída' : 'Pendente' %> · <%= task.priority == 'high' ? 'Alta' : 'Normal' %> prioridade</small></span></div><% end %><% if tasks.empty? %><p class="space-empty">Nenhuma tarefa registrada.</p><% end %>
