<turbo-frame id="project-modal">
  <dialog class="dialog project-dialog project-native-dialog" data-project-dialog data-controller="project-form" data-action="cancel->project-form#cancel close->project-form#afterClose keydown->project-form#keys" aria-labelledby="project-dialog-title" aria-describedby="project-form-hint">
    <%= form_with url: @project.persisted? ? project_path(@project) : projects_path, method: @project.persisted? ? :patch : :post, scope: :project, id: "project-form", data: {action: "submit->project-form#submit input->project-form#preview"} do |form| %>
      <%= hidden_field_tag :intent, @intent unless @project.persisted? %><%= hidden_field_tag :version, @project.lock_version %>
      <div class="block-top"><div><div class="eyebrow">SEU ESPAÇO, SEU JEITO</div><h2 id="project-dialog-title"><%= @project.persisted? ? "Editar projeto" : "Novo projeto" %></h2></div><button type="button" class="project-close" data-action="project-form#close" aria-label="Fechar formulário de projeto"><%= studio_icon("x", 19) %></button></div>
      <div class="project-form-preview" id="project-preview" style="<%= project_style(@project) %>"><span class="project-emblem"><%= studio_icon(@project.icon, 24) %></span><strong data-preview-name><%= @project.name.presence || "Seu próximo projeto" %></strong></div>
      <label for="project-name">Nome<%= form.text_field :name, value: @project.name, id: "project-name", required: true, maxlength: 80, autocomplete: "off", autofocus: true %></label>
      <label for="project-description">Descrição <span class="project-optional">opcional</span><%= form.text_area :description, value: @project.description, id: "project-description", maxlength: 500, rows: 3 %></label>
      <div class="project-form-properties"><label for="project-icon">Ícone<%= form.select :icon, Project::ICONS.map { |key| [ProjectsHelper::PROJECT_ICONS.fetch(key), key] }, {selected: @project.icon}, id: "project-icon" %></label><label for="project-color">Cor<input id="project-color" type="color" value="<%= project_color(@project) %>"><%= form.hidden_field :color, value: @project.color, id: "project-color-value" %><input id="project-color-hex" aria-label="Cor hexadecimal" type="text" required pattern="#[0-9a-fA-F]{6}" maxlength="7" value="<%= project_color(@project) %>" spellcheck="false"></label></div>
      <div hidden><% Project::ICONS.each do |icon| %><span data-project-icon-preview="<%= icon %>"><%= studio_icon(icon, 24) %></span><% end %></div>
      <p class="project-form-error" role="alert" data-project-notice></p><div data-project-remote hidden></div><div class="project-conflict-actions"><button type="button" class="button tertiary" hidden data-project-reapply data-action="project-form#reapply">Reaplicar minha edição</button><button type="button" class="button tertiary" hidden data-project-reload data-action="project-form#reload">Carregar versão atual</button></div>
      <p id="project-form-hint"><%= @project.persisted? ? "O ID, os vínculos e as datas de origem serão preservados." : "Você poderá pausar, favoritar ou arquivar este espaço depois." %></p>
      <div class="project-form-actions"><button type="button" class="button tertiary" data-action="project-form#close">Cancelar</button><button type="submit" class="button"><%= studio_icon("check", 16) %> <%= @project.persisted? ? "Salvar alterações" : "Criar projeto" %></button></div>
    <% end %>
  </dialog>
</turbo-frame>
