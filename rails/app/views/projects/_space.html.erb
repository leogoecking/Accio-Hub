<div class="inner-page project-space" style="<%= project_style(@project) %>" data-controller="project-tabs" data-action="keydown->project-tabs#keys click->project-tabs#remember">
  <%= link_to "← Biblioteca de Projetos", projects_path, class: "quiet-link space-back", data: {turbo_frame: "_top"} %><div class="project-library-heading space-heading"><span class="project-emblem"><%= studio_icon(@project.icon, 28) %></span><div><div class="eyebrow">SEU ESPAÇO DE TRABALHO</div><h1 id="space-title" tabindex="-1"><%= @project.name %><span class="title-stop">.</span></h1><p><%= @project.description.presence || "Ideias, atividades e referências no mesmo lugar." %></p></div><span class="project-status status-<%= @project.status %>"><%= ProjectsHelper::PROJECT_STATUSES.fetch(@project.status) %></span></div>
  <% if @project.status == "archived" %><p class="space-archive" role="status">Projeto arquivado · registros preservados. Restaure-o na Biblioteca para editar.</p><% end %>
  <div class="space-tabs" role="tablist" aria-label="Áreas do projeto"><% {"overview" => "Visão Geral", "tasks" => "Tarefas", "knowledge" => "Conhecimento", "references" => "Referências"}.each do |key, label| %><%= link_to label, project_path(@project, tab: key), id: "space-tab-#{key}", role: "tab", tabindex: @tab == key ? 0 : -1, aria: {selected: @tab == key, controls: "space-content"}, data: {turbo_frame: "_top", project_tab: key} %><% end %></div><p class="space-feedback" role="status" data-project-notice></p>
  <div id="space-content" role="tabpanel" aria-labelledby="space-tab-<%= @tab %>">
    <% if @tab == "overview" %><div class="widget-grid space-grid">
      <section class="panel span-5" aria-labelledby="space-tasks-title"><div class="panel-top"><h2 id="space-tasks-title">Tarefas pendentes</h2></div><div class="space-panel-content"><%= render "tasks", tasks: @tasks.select { |t| t.status == 'pending' }.first(4) %></div></section>
      <section class="panel panel-focus span-3" aria-labelledby="space-focus-title"><div class="panel-top"><h2 id="space-focus-title">Foco</h2></div><%= render "studio/widgets/focus" %></section>
      <section class="panel span-4" aria-labelledby="space-info-title"><div class="panel-top"><h2 id="space-info-title">Informações do projeto</h2></div><div class="space-info"><p><%= @project.description.presence || "Seu próximo passo começa aqui." %></p><dl><dt>Status</dt><dd><%= ProjectsHelper::PROJECT_STATUSES.fetch(@project.status) %></dd><dt>Tarefas pendentes</dt><dd><%= @tasks.count { |t| t.status == 'pending' } %></dd><dt>Referências</dt><dd><%= @references.size %></dd></dl><% unless @project.status == "archived" %><%= link_to "Editar projeto", edit_project_path(@project), class: "button tertiary", id: "project-edit-#{@project.to_param}", data: {turbo_frame: "project-modal", project_opener: true} %><% end %></div></section>
      <section class="panel span-12" aria-labelledby="space-notes-title"><div class="panel-top"><h2 id="space-notes-title">Conhecimento</h2></div><p class="space-empty">A integração das notas com o Vault Markdown acontecerá na P1.3. Nenhuma nota foi importada.</p></section>
    </div><% elsif @tab == "tasks" %><div class="inner-block"><h2>Tarefas deste projeto</h2><%= render "tasks", tasks: @tasks %></div>
    <% elsif @tab == "knowledge" %><div class="inner-block"><h2>Conhecimento deste projeto</h2><p class="space-empty">Integração com o Vault Markdown prevista para a P1.3. Nenhuma nota fictícia é vinculada a este projeto.</p></div>
    <% else %><div class="inner-block"><h2>Links e materiais</h2><p class="muted">Consulta somente leitura. Edição prevista para a P1.2D3.</p><% @references.each do |reference| %><article class="space-reference"><h3><%= reference.title %></h3><p><%= reference.description %></p><% if safe_reference_url(reference.url) %><%= link_to "Abrir #{reference.title}", safe_reference_url(reference.url), target: "_blank", rel: "noopener noreferrer" %><% end %></article><% end %><% if @references.empty? %><p class="space-empty">Nenhuma referência registrada.</p><% end %></div><% end %>
  </div>
</div>
