<div class="inner-page project-library" data-controller="project-library" data-action="submit->project-library#search input->project-library#scheduleSearch change->project-library#filter click->project-library#click">
  <div class="project-library-heading"><div><div class="eyebrow">ACCIO HUB / SEUS ESPAÇOS</div><h1>Projetos<span class="title-stop">.</span></h1><p>Uma coleção do que você quer construir.</p></div><%= link_to new_project_path, class: "button", id: "project-new", data: {turbo_frame: "project-modal", project_opener: true} do %><%= studio_icon("plus", 17) %> Novo projeto<% end %></div>
  <div class="project-toolbar">
    <%= form_with url: projects_path, method: :get, class: "project-search" do |form| %><%= form.label :q, "Pesquisar projetos", class: "sr-only", for: "project-search" %><%= studio_icon("search", 17) %><%= form.search_field :q, value: params[:q], id: "project-search", placeholder: "Buscar por nome ou descrição", autocomplete: "off" %><button class="sr-only" type="submit" tabindex="-1">Buscar</button><% end %>
    <label class="project-order" for="project-order">Ordenar <select id="project-order" data-filter="project_library_sort"><%= options_for_select([["Por nome", "name"], ["Atividade recente", "recent"]], @filters["project_library_sort"]) %></select></label>
  </div>
  <div class="project-filter-row"><div class="project-filters" role="group" aria-label="Filtros de projetos"><% {"all" => "Todos", "active" => "Ativos", "paused" => "Pausados", "archived" => "Arquivados"}.each do |value, label| %><button id="project-filter-<%= value %>" class="project-filter <%= 'selected' if @filters['project_library_status'] == value %>" type="button" data-filter-status="<%= value %>" aria-pressed="<%= @filters['project_library_status'] == value %>"><%= label %></button><% end %></div><button id="project-favorites" class="project-filter <%= 'selected' if @filters['project_library_favorites_only'] %>" type="button" data-filter-favorites aria-pressed="<%= @filters['project_library_favorites_only'] %>"><%= studio_icon("star", 16) %> Favoritos</button></div>
  <div class="project-feedback" role="status" data-project-notice></div>
  <div id="project-results" class="project-library-results" role="region" aria-label="Resultados da biblioteca"><div class="project-results-label"><span role="status"><%= @projects.size %> de <%= Current.user.projects.count %> projeto<%= 's' unless Current.user.projects.count == 1 %></span><span class="project-local-label">SQLITE / SUA CONTA</span></div><div class="project-library-grid">
    <% @projects.each do |project| %><%= render "card", project: project %><% end %>
    <% if @projects.empty? %><div class="project-empty"><h2><%= Current.user.projects.exists? ? "Nenhum resultado" : "Seu primeiro espaço começa aqui" %></h2><p>Crie um projeto ou ajuste a pesquisa e os filtros.</p></div><% end %>
  </div></div>
</div>
