<!DOCTYPE html>
<html lang="pt-BR" data-theme="<%= (@appearance || Studio.defaults)["theme"] %>" data-wallpaper="<%= (@appearance || Studio.defaults)["wallpaper"] %>" style="--accent:<%= (@appearance || Studio.defaults)["accent"] %>">
  <head>
    <title>Accio Hub · <%= @page ? Studio::LABELS[@page] : "Acesso local" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "fonts", "studio", "foundation", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body><%= yield %></body>
</html>
