<div id="dashboard-tasks"><% tasks = Current.user.tasks.includes(:project).order(position: :desc, uid: :asc); pending = tasks.where(status: "pending") %>
<div class="task-stat"><strong><%= pending.count.to_s.rjust(2, '0') %></strong><span>tarefas para fazer <em><%= tasks.where(status: "completed").count %> concluída(s)</em></span></div><p class="space-feedback" role="status" data-project-notice></p><%= render "tasks/list", tasks: pending.limit(4), widget: true %></div>
