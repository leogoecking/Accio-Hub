<% context = local_assigns.fetch(:context, {}); archived = local_assigns.fetch(:archived, false) %>
<div class="focus-body" data-focus-target="surface" data-focus-context="<%= context.to_json %>" data-focus-archived="<%= archived %>">
  <div class="dial" style="--p:0%" data-focus-dial><div class="dial-inner"><small>SESSÃO DE FOCO</small><strong data-timer data-focus-clock>--:--</strong><span data-focus-state>Consultando servidor</span></div></div>
  <p class="focus-context" data-focus-context-label>Um único Pomodoro em todas as telas.</p>
  <div class="focus-actions">
    <button type="button" class="round-btn primary-action" data-focus-primary data-action="focus#primary" aria-label="Iniciar Pomodoro" disabled><span data-focus-icon><%= studio_icon("play", 20) %></span></button>
    <button type="button" class="round-btn" data-focus-reset data-action="focus#reset" aria-label="Reiniciar Pomodoro" title="Reiniciar" disabled>↻</button>
    <button type="button" class="round-btn" data-focus-preset data-action="focus#preset" aria-label="Selecionar preset de 25 ou 45 minutos" title="Selecionar 25/45 minutos" disabled>25m</button>
  </div>
  <div class="focus-secondary"><button type="button" class="quiet-link" data-focus-cancel data-action="focus#cancel" hidden>Cancelar sessão</button><button type="button" class="quiet-link" data-action="focus#reconnect">Atualizar estado</button></div>
  <p class="focus-feedback" data-focus-feedback role="status" aria-live="polite"></p>
  <div class="focus-recovery" data-focus-recovery hidden>
    <p>Parte do intervalo não pôde ser confirmada automaticamente.</p><p data-focus-checkpoint></p><p data-focus-estimate></p>
    <button type="button" class="button tertiary" data-focus-resolve="keep_checkpoint" data-action="focus#resolve">Manter checkpoint</button>
    <button type="button" class="button tertiary" data-focus-resolve="accept_estimate" data-action="focus#resolve">Aceitar estimativa</button>
  </div>
</div>
