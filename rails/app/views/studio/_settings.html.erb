<div class="setting-group"><%= content_tag "h#{level}", "Plano de fundo" %><div class="wallpaper-options"><% [["northern", "Aurora"], ["ember", "Pôr do sol"], ["ocean", "Azul profundo"], ["graphite", "Grafite"]].each do |id, label| %><button class="wallpaper-swatch wall-<%= id %>" data-wallpaper="<%= id %>" aria-pressed="<%= @appearance['wallpaper'] == id %>"><span><%= label %></span></button><% end %></div></div>
<div class="setting-group"><%= content_tag "h#{level}", "Preferências" %>
  <div class="setting-row"><label for="<%= prefix %>-accent">Cor de destaque <small>Botões e seleções</small></label><input type="color" id="<%= prefix %>-accent" data-pref="accent" value="<%= @appearance['accent'] %>"></div>
  <div class="setting-row"><label for="<%= prefix %>-theme">Tema <small>Claro e escuro</small></label><select id="<%= prefix %>-theme" data-pref="theme"><option value="dark" <%= 'selected' if @appearance['theme'] == 'dark' %>>Escuro</option><option value="light" <%= 'selected' if @appearance['theme'] == 'light' %>>Claro</option></select></div>
  <div class="setting-row"><label for="<%= prefix %>-music">Accio Music <small>Barra global demonstrativa</small></label><input type="checkbox" id="<%= prefix %>-music" data-pref="music" <%= 'checked' if @appearance['music'] %>></div>
</div>
<div class="setting-group"><%= content_tag "h#{level}", "Dock de aplicativos" %><div data-setting-dock class="widget-settings">
  <% @appearance['dockOrder'].each do |id| %><% label = Studio::DOCK.find { |d| d.first == id }[1] %><div class="setting-row" data-dock-row="<%= id %>"><label class="show-label"><input type="checkbox" data-dock-visible="<%= id %>" <%= 'checked' unless @appearance['dockHidden'].include?(id) %>><%= label %></label><button class="mini-control" data-order="dock" data-id="<%= id %>" data-direction="-1" aria-label="Mover <%= label %> para antes na Dock">↑</button><button class="mini-control" data-order="dock" data-id="<%= id %>" data-direction="1" aria-label="Mover <%= label %> para depois na Dock">↓</button></div><% end %>
</div></div>
<div class="setting-group"><%= content_tag "h#{level}", "Widgets" %><div data-setting-widgets class="widget-settings">
  <% @appearance['widgets'].each do |w| %><% title = Studio::WIDGETS[w['id']]['title'] %><div class="setting-row" data-widget-row="<%= w['id'] %>"><label class="show-label"><input type="checkbox" data-visible="<%= w['id'] %>" <%= 'checked' if w['visible'] %>><%= title %></label><select data-span="<%= w['id'] %>" aria-label="Tamanho de <%= title %>"><% [3,4,5,6,8,12].each do |span| %><option value="<%= span %>" <%= 'selected' if w['span'] == span %>><%= span %>/12</option><% end %></select><button class="mini-control" data-order="widgets" data-id="<%= w['id'] %>" data-direction="-1" aria-label="Mover <%= title %> para antes">↑</button><button class="mini-control" data-order="widgets" data-id="<%= w['id'] %>" data-direction="1" aria-label="Mover <%= title %> para depois">↓</button></div><% end %>
</div><button class="button tertiary" data-reset-widgets>Restaurar widgets sugeridos</button></div>
<p class="setting-note">Preferências deste navegador em cookie criptografado. Nenhum dado pessoal, áudio ou backup é conectado nesta etapa.</p>
