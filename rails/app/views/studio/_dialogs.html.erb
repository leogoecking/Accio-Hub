<dialog id="customize" class="foundation-overlay" aria-labelledby="customize-title" data-action="cancel->studio#cancel close->studio#afterClose">
  <div class="scrim" data-backdrop><div class="drawer"><div class="drawer-head"><div class="eyebrow">ACCIO STUDIO</div><h2 id="customize-title">Deixe com a sua cara.</h2><button class="mini-control" data-close aria-label="Fechar personalização"><%= studio_icon("x") %></button></div><%= render "settings", prefix: "drawer", level: 3 %><button class="button drawer-done" data-close>Concluir personalização</button></div></div>
</dialog>
<dialog id="search" class="foundation-overlay" aria-labelledby="search-title" data-action="cancel->studio#cancel close->studio#afterClose">
  <div class="scrim" data-backdrop><search class="search-modal" aria-label="Busca global de aplicativos"><h2 id="search-title" class="sr-only">Buscar aplicativos</h2><div class="search-field"><%= studio_icon("search", 21) %><input id="command-search" aria-label="Buscar aplicativos" autocomplete="off" placeholder="Buscar aplicativos..." data-controller="task-search" data-action="input->studio#search input->task-search#search keydown->studio#searchKeys"><span>ESC</span></div><nav class="search-results" aria-label="Resultados da busca">
    <% Studio::NAV.each do |id, label, icon| %><%= link_to studio_path(id), data: {search_result: label}, class: "search-result" do %><%= studio_icon(icon, 18) %><span><%= label %><small>Aplicativo · <%= id == 'home' ? 'Seu espaço' : %w[projects tasks].include?(id) ? 'SQLite' : 'Demonstração P1.1' %></small></span><%= studio_icon('chevron', 14) %><% end %><% end %><p hidden data-search-empty>Nenhum resultado encontrado.</p>
    <div data-task-search-results></div>
  </nav></search></div>
</dialog>
<dialog id="demo" class="foundation-overlay" aria-labelledby="demo-title" data-action="cancel->studio#cancel close->studio#afterClose"><div class="scrim" data-backdrop><div class="dialog global-dialog"><div class="block-top"><h2 id="demo-title">Demonstração da P1.1</h2><button class="mini-control" data-close aria-label="Fechar demonstração"><%= studio_icon("x") %></button></div><p class="muted" data-demo-message>Este módulo utiliza dados ilustrativos e somente de leitura. A persistência funcional será entregue nas próximas etapas.</p><button class="button" data-close>Entendi</button></div></div></dialog>
