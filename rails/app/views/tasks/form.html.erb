<turbo-frame id="task-modal"><dialog class="dialog global-dialog project-native-dialog" data-project-dialog data-task-dialog data-controller="task-form" data-action="cancel->task-form#cancel close->task-form#afterClose keydown->task-form#keys" aria-labelledby="task-dialog-title" aria-describedby="task-form-hint">
  <%= form_with url: @task.persisted? ? (@context ? project_task_path(@context, @task) : task_path(@task)) : (@context ? project_tasks_path(@context) : tasks_path), method: @task.persisted? ? :patch : :post, scope: :task, id: "task-form", data: {action: "submit->task-form#submit input->task-form#preview change->task-form#preview"} do |form| %>
    <%= hidden_field_tag :intent, @intent unless @task.persisted? %><%= hidden_field_tag :version, @task.lock_version %>
    <div class="block-top"><h2 id="task-dialog-title"><%= @task.persisted? ? "Editar tarefa" : "Nova tarefa" %></h2><button type="button" class="mini-control" data-action="task-form#close" aria-label="Fechar formulário de tarefa"><%= studio_icon("x") %></button></div>
    <label for="task-title">Título<%= form.text_field :title, value: @task.title, id: "task-title", required: true, maxlength: 120, autocomplete: "off", autofocus: true, placeholder: "O que precisa fazer?" %></label>
    <label for="task-priority">Prioridade<%= form.select :priority, [["Normal", "normal"], ["Alta", "high"]], {selected: @task.priority}, id: "task-priority" %></label>
    <% if @context %><p class="muted">Projeto: <strong><%= @context.name %></strong> · vínculo definido por este espaço.</p><% else %><label for="task-project">Projeto<%= form.select :project_uid, [["Pessoal", ""]] + @choices.map { |project| [project.name, project.to_param] }, {selected: @task.project&.to_param}, id: "task-project" %></label><% end %>
    <p class="project-form-error" role="alert" data-project-notice></p><p hidden data-task-remote></p><div class="project-conflict-actions"><button type="button" class="button tertiary" hidden data-task-reapply data-action="task-form#reapply">Reaplicar minha edição</button><button type="button" class="button tertiary" hidden data-task-reload data-action="task-form#reload">Carregar versão atual</button></div>
    <p id="task-form-hint" class="muted">Salva no SQLite. O ID e a data de conclusão serão preservados ao editar.</p><div class="project-form-actions"><button type="button" class="button tertiary" data-action="task-form#close">Cancelar</button><button type="submit" class="button"><%= studio_icon("check", 16) %> Salvar tarefa</button></div>
  <% end %>
</dialog></turbo-frame>
