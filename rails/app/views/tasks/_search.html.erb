<% @tasks.each do |task| %><%= link_to tasks_path(dialog: task.to_param), class: "search-result", data: {search_result: task.title} do %><%= studio_icon("check", 18) %><span><%= task.title %><small>Tarefa · <%= task.project&.name || "Pessoal" %><%= ' · Arquivado · somente leitura' if task.project&.status == 'archived' %></small></span><%= studio_icon("chevron", 14) %><% end %><% end %>
