<% pending = @tasks.count { |task| task.status == 'pending' } %>
<%= render "studio/shell" do %><turbo-frame id="task-surface"><div class="inner-page"><div class="subhead"><div class="eyebrow">ACCIO HUB / PRODUTIVIDADE</div><h1 id="tasks-title" tabindex="-1">Tarefas<span class="title-stop">.</span></h1></div><%= link_to new_task_path, class: "button", id: "task-new-top", data: {turbo_frame: "task-modal", task_opener: true} do %><%= studio_icon("plus", 17) %> Nova tarefa<% end %><div class="inner-block"><div class="block-top"><h2>Suas atividades</h2><span class="badge"><%= pending %> <%= pending == 1 ? 'aberta' : 'abertas' %></span></div><p class="space-feedback" role="status" data-project-notice></p><%= render "list", tasks: @tasks %></div></div></turbo-frame><% end %>
